# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# Test server ID (right click the server -> Copy Server ID, needs Developer Mode).
# When set, slash commands sync only there, instantly. Leave empty for a global sync.
DISCORD_DEV_GUILD_ID=
# Channel where the bot posts tracebacks of unexpected errors (e.g. #errors). Optional.
DISCORD_ERRORS_CHANNEL_ID=

# https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=
# Public free key
THESPORTSDB_KEY=123

DATABASE_URL=sqlite:///data/footballbot.db
# Time zone used for "today" in /matches and for kick-off times
TIMEZONE=America/Bogota
LOG_LEVEL=INFO
